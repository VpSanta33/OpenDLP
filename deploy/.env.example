# 复制为 .env 后修改；.env 含密钥，切勿提交到版本库

# 数据库口令（建议仅使用字母与数字，否则需在连接串中做 URL 编码）
POSTGRES_PASSWORD=ChangeMe0123456789

# 终端 Agent / 网关上报令牌，可用 `openssl rand -hex 32` 生成
OPENDLP_AGENT_TOKEN=change-me-to-a-random-64-char-hex-string

# 对外访问域名（需解析到本机，Caddy 自动申请证书）；本机测试可用 localhost
OPENDLP_DOMAIN=localhost

# 可选：指定首次初始化令牌（不设置则随机生成并打印在 app 容器日志中）
# OPENDLP_SETUP_TOKEN=

# 可选
# OPENDLP_VERSION=3.3.0
# OPENDLP_TZ=Asia/Shanghai
